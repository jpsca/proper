{% extends 'layouts/application.html.jinja2' %}

{% block title %}Sign in{% endblock %}

{% block body %}
<h1>Sign in</h1>

<form method="post" action="" id="signInForm" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ req.csrf_token }}">
  
  {{ form.render_error() }}
  {{ form.login.render_error() }}
  {{ form.password.render_error() }}

  <div>
    {{ form.login.as_input(label="Email") }}
  </div>
  <div>
    {{ form.password.as_input(label="Password") }}
    <a href="{{ app.url_for('Sessions.reset') }}">Forgot password?</a>
  </div>
  
  <button type="submit">Sign in</button>
</form>
{% endblock %}