{% extends 'layouts/application.html.jinja2' %}

{% block title %}Change your password{% endblock %}

{% block body %}
<h1>Change password for {{ req.current_user.login }}</h1>

<form method="post" action="" id="passwordChangeForm" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ req.csrf_token }}">
  
  {{ form.render_error() }}
  {{ form.password.render_error() }}

  <div>
    {{ form.password.as_input(label="Password") }}
    {{ form.password.as_input(label="Confirm password") }}
  </div>
  <p class="help">Make sure it's at least {{ app.config.auth.password_minlen }} characters.</p>
  
  <button type="submit">Change password</button>
</form>
{% endblock %}