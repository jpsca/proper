{% extends "layouts/auth.html.jinja" %}

{% block title %}Sign in{% endblock %}

{% block body %}
<div class="h-screen max-w-lg mx-auto">
	<div class="flex items-center h-full p-10 bg-white border-l border-r border-gray-400 shadow-md">
		<form method="post" action="" class="w-full" id="signInForm" novalidate>
			<input type="hidden" name="_csrf_token" value="{{ req.csrf_token }}">

			<div class="mb-8 text-center">
				<h2 class="mt-6 text-3xl font-bold text-gray-900">
					Sign in
				</h2>
			</div>

			<div class="mb-1">
				{{ form.login.as_input(
					aria_label="Email",
					classes="form-input w-full lowercase text-lg py-3 rounded-none rounded-t-md",
					error="border-red-500",
					placeholder="Email",
					tabindex="1"
				) }}
				{{ form.login.render_error(classes="text-red-500 text-sm font-bold mb-3 mt-2") }}
			</div>

			<div>
				{{ form.password.as_input(
					aria_label="Password",
					classes="form-input w-full text-lg py-3 rounded-none rounded-b-md",
					error="border-red-500",
					placeholder="Password",
					tabindex="2"
				) }}
				{{ form.password.render_error(classes="text-red-500 text-sm font-bold mb-3 mt-2") }}
			</div>

			<div class="mt-8">
				<button class="btn w-full py-3 uppercase bg-gray-100 hover:bg-gray-200" type="submit" tabindex="3">
					Sign in
				</button>
			</div>

			<div class="mt-6 text-right">
				<a class="text-sm link"
					href="{{ url_for('Auth.reset') }}"
					tabindex="4"
				>
					Forgot your password?
				</a>
			</div>
		</form>
	</div>
</div>
{% endblock %}
