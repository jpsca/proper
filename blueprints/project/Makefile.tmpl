.PHONY: setup
setup:  # Requires an active virtualenv
	pip install -U pip wheel --quiet
	pip install -r requirements/dev-requirements.txt
	pip install -e .
	make db
	cd static && npm install --quiet

.PHONY: run
run:
	python manage.py run

.PHONY: test
test:
	pytest -x tests

.PHONY: lint
lint:
	flake8 --config=setup.cfg [[ app_name ]]

.PHONY: db
db:
	rm db/[[ app_name ]].sqlite || true
	# python manage.py db upgrade
	python manage.py db create_all
