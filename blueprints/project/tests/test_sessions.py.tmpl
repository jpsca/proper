@db_session
def test_sign_in(web, db):
    user = User(login="test", password="qwertyuiop")
    db.commit()  # The user must have an ID to be able to sign-in.
    try:
        res = web.get("/sign-in")
        form = res.forms["signInForm"]
        form["login"] = "test"
        form["password"] = "qwertyuiop"
        res = form.submit()

        assert res.status == "303 See Other"
        assert res.headers.get("location") == "/user/"

        res = web.get("/user/")
        assert res.status == "200 OK"
        assert "<title>Private page</title>" in res.text
    finally:
        user.delete()
