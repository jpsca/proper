{% extends "layouts/application.html.jinja" %}

{% block title %}[[ plural_pascal ]]{% endblock %}

{% block body %}
<h1>[[ plural_pascal ]]</h1>

<div>
  <ul>
  {% for [[ singular_snake ]] in [[ plural_snake ]] -%}
  <li><a href="{{ url_for('[[ plural_pascal ]].show', pk=[[ singular_snake ]].id) }}">
    {{ [[ singular_snake ]] }}
  </a></li>
  {% endfor -%}
  </ul>
</div>

<p><a href="{{ url_for('[[ plural_pascal ]].new') }}">New [[ singular_snake ]]</a></p>
{% endblock %}
