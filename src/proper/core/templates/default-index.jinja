<!DOCTYPE html>
<html lang="en">
<head>
  <title>Proper Web Framework {{ proper_version }}</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <style type="text/css">
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      -moz-osx-font-smoothing: grayscale;
      align-items: center;
      background-color: #fff8f4;
      background-position: center center;
      background-repeat: no-repeat;
      background-size: cover;
      min-height: 100vh;
    }
    main {
      color: #261b23;
      font-family: 'Calibre', Sans-Serif;
      font-size: calc(0.9rem + 0.8vw);
      font-style: normal;
      font-weight: 400;
      line-height: 1.5;
      text-align: center;
      position: absolute;
      min-height: 460px;
      height: 100%;
      display: block;
      width: 100%;
    }
    nav {
      width: 100%;
      text-align: center;
      padding: 3rem 2rem;
      display: block;
    }
    h1 a,
    h1 a:visited {
      display: inline-block;
      text-align: center;
      cursor: pointer;
      font-size: 7rem;
      text-decoration: underline;
      text-decoration-style: dotted;
      color: #0a6fc1;
      fill: #0a6fc1;
      font-weight: 600;
      letter-spacing: -0.05ch;
      transition: all;
      width: 100%;
      max-width: 80%;
    }
    h1 a:hover,
    h1 a:active {
      text-decoration-style: solid;
    }
    h1 a svg {
      display: inline-block;
    }
    ul {
      bottom: 0;
      left: 0;
      list-style: none;
      padding: 2rem 2rem 3rem;
      position: absolute;
      right: 0;
      font-size: calc(0.9rem + 0.3vw);
    }
    li {
      padding: 0.2rem;
    }
  </style>
</head>

