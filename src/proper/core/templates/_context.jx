{% macro print_dict(dict) -%}
	<div class="scroll">
		<table>
			{%- for name, value in dict.items() %}
			<tr>
				{% if value is mapping and value -%}
					<td colspan="2">
						<details>
							<summary>{{ name }}</summary>
							{{ print_dict(value) }}
						</details>
					</td>
				{%- else -%}
					<th>{{ name }}</th>
					<td>{{ value }}</td>
				{%- endif %}
			</tr>
			{%- endfor %}
		</table>
	</div>
{%- endmacro -%}

<h2>Request and app</h2>

{% if request_query -%}
<details class="section" open>
	<summary>Query</summary>
	{{ print_dict(request_query) }}
</details>
{%- endif %}

{% if request_form -%}
<details class="section" open>
	<summary>Form data</summary>
	{{ print_dict(request_form) }}
</details>
{%- endif %}

{% if request_headers -%}
<details class="section">
	<summary>Request headers</summary>
	{{ print_dict(request_headers) }}
</details>
{%- endif %}

{% if response.headers -%}
<details class="section">
	<summary>Response headers</summary>
	<div class="scroll">
		<table>
			{%- for name, value in response.get_header_tuples() %}
			<tr><th>{{ name }}</th><td>{{ value }}</td></tr>
			{%- endfor %}
		</table>
	</div>
</details>
{%- endif %}

<details class="section">
	<summary>Config</summary>
	{{ print_dict(config) }}
</details>
