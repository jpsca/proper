{% extends 'layout.jx' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<h2>Routes</h2>
<p class="note">Routes match in priority from top to bottom.
The build-only ones, without a <code>to</code>, never match.</p>

<div class="scroll">
	<table class="routes">
		<tr>
			<th></th>
			<th>Path</th>
			<th>To</th>
			<th>Name</th>
			<th>Host</th>
		</tr>
		{%- for route in routes %}
		<tr{% if route.build_only %} class="build-only" title="Build-only"{% endif %}>
			<td>{{ route.method or '-' }}</td>
			<td>
				{%- if route.method == 'GET' -%}
				<a href="{{ route.path }}" target="_blank">{{ route.path }}</a>
				{%- else -%}
				{{ route.path }}
				{%- endif -%}
			</td>
			<td>
				{%- if route.to %}{{ route.to.__qualname__ }}
				{%- elif route.redirect %}↪ {{ route.redirect }}
				{%- else %}–{% endif -%}
			</td>
			<td>{{ route.name or '-' }}</td>
			<td>{{ route.host or '-' }}</td>
		</tr>
		{%- endfor %}
	</table>
</div>
{% endblock %}
