<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width,initial-scale=1">
	<title>{% block title %}{% endblock %}</title>
	<style>{{ include_raw("_debug-styles.css") }}</style>
</head>

<body>
	<header>
		<div class="wrap">
			{% block actions %}{% endblock %}
			{% if description -%}
			<p class="kind">{{ title }}</p>
			<h1>{{ description }}</h1>
			{%- else -%}
			<h1>{{ title }}</h1>
			{%- endif %}
			{% if request_line %}<p class="request">{{ request_line }}</p>{% endif %}
		</div>
	</header>
	<main class="wrap">
		{% block body %}{% endblock %}
		{% include "_context.jx" %}
	</main>
</body>
</html>
