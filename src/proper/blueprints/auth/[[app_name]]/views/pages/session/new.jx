{#import "layouts/auth.jx" as Layout #}
{#import "common/password.jx" as Password #}
{#import "form.jx" as Form #}

{#def form #}

<Layout title="Sign in" data_turbo="false">
  <Form class="auth-panel" action={{ url_for('Session.create') }}>
    <div class="auth-header">
      <h2 class="auth-title">Sign in</h2>
      <p class="auth-text">Enter your email and password below to sign in to your&nbsp;account.</p>
    </div>

    <div class="auth-field">
      {{ form.login.label("Email") }}
      {{ form.login.text_input(placeholder="Email") }}
      {{ form.login.error_tag() }}
    </div>

    <div class="auth-field">
      <Password field={{form.password}} label="Password" placeholder="Password" />
    </div>

    <div class="auth-footer">
      <button type="submit" class="btn btn--primary">Sign in</button>
    </div>

    <div class="auth-back">
      <a href="{{ url_for('PasswordReset.new') }}">Forgot your password?</a>
    </div>
  </Form>

  <div class="auth-back">
    <a href="{{ url_for('SignUp.new') }}">Don't have an account? Sign Up</a>
  </div>
</Layout>