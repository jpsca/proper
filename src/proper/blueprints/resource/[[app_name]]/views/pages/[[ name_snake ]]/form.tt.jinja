{#import "form.jinja" as Form #}

{#def form, action='', method='post' #}

<Form method={{ method }} action={{ action }}>
  [% for f in form_fields -%]
  <div class="field">
    {{ form.[[ f.name ]].label("[[ f.name|title ]]") }}
    {{ form.[[ f.name ]].text_input() }}
    {{ form.[[ f.name ]].error_tag() }}
  </div>
  [% endfor -%]

  {{ content }}
</Form>
