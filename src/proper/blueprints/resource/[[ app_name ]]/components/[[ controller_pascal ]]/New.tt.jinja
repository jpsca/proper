{#def form #}

<Layout.App
	title="New [[ singular_snake ]]"
	class="mt-10 mx-auto px-5 max-w-screen-md"
>
	<h1 class="font-bold text-2xl">New [[ singular_snake ]]</h1>

	<[[ controller_pascal ]].Form
		action={url_for('[[ plural_pascal ]].create')}
		form={form}
	>
		<div class="mt-6">
			<button
				type="submit"
				class="text-xl bg-blue-500 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded focus:outline-none focus:shadow-outline"
			>Create [[ singular_snake ]]</button>
		</div>
	</[[ controller_pascal ]].Form>
</Layout.App>
