{#def form, [[ name_snake ]] #}

<Layout.App title="Edit [[ name_snake ]]">
	<[[ name_pascal ]].Form
		method="patch"
		action={{ url_for('[[ name_pascal ]].update', pk=[[ name_snake ]].id) }}
		form={{ form }}
	>
		<button type="submit">Update [[ name_snake ]]</button>
	</[[ name_pascal ]].Form>
</Layout.App>
