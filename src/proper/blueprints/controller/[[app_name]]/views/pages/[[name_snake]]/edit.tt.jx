{#import "layouts/app.jx" as Layout #}
{#import "./form.jx" as [[ name_pascal ]]Form #}

{#def form, [[ name_snake ]] #}

<Layout title="Edit [[ name_snake ]]">
	<[[ name_pascal ]]Form
		method="patch"
		action={{ url_for('[[nsprefix]][[ name_pascal ]].update', [[ name_snake ]]) }}
		form={{ form }}
	>
		<div class="form-group">
			<button type="submit" class="btn btn--primary">Update [[ name_snake ]]</button>
			<a href={{ url_for('[[nsprefix]][[ name_pascal ]].index') }}>Cancel</a>
		</div>
	</[[ name_pascal ]]Form>
</Layout>
