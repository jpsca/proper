{#import "layouts/app.jx" as Layout #}

{#def [[ plural_snake ]] #}

<Layout title="[[ plural_human ]]">
  <h1>[[ plural_human | title ]]</h1>
  <a class="btn" href="{{ url_for('[[ nsprefix ]][[ name_pascal ]].new') }}">New [[ name_human ]]</a>

  {% for [[ name_snake ]] in [[ plural_snake ]] -%}
    <div id="[[ name_snake ]]-{{ [[ name_snake ]].id }}">
      [% for f in render_fields -%]
      <div>
        <strong>[[ f.label ]]</strong>
        {{ [[ name_snake ]].[[ f.name ]] }}
      </div>
      [% endfor -%]
      <a href="{{ url_for('[[ nsprefix ]][[ name_pascal ]].show', [[ name_snake ]]) }}">Show this [[ name_human ]]</a>
    </div>
  {% endfor -%}
</Layout>
