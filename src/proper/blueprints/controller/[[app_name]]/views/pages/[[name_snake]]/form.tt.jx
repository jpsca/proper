{#import "form.jx" as Form #}

{#js "js/nestedform.js" #}

{#def form, action='', method='post' #}

<Form method={{ method }} action={{ action }}>
  [% for f in render_fields -%]
  <div class="field">
    {{ form.[[ f.name ]].label("[[ f.label ]]") }}
    {{ form.[[ f.name ]].[[ f.method ]]() }}
    {{ form.[[ f.name ]].error_tag() }}
  </div>
  [% endfor -%]

  {{ content }}
</Form>
