{#import "layouts/app.jx" as Layout #}
{#import "./form.jx" as [[ name_pascal ]]Form #}

{#def form #}

<Layout title="New [[ name_human ]]">
	<h1>New [[ name_human ]]</h1>
	<[[ name_pascal ]]Form
		action={{ url_for('[[nsprefix]][[ name_pascal ]].create') }}
		form={{ form }}
	>
		<div class="form-group">
			<button type="submit" class="btn btn--primary">Create [[ name_human ]]</button>
			<a href={{ url_for('[[nsprefix]][[ name_pascal ]].index') }}>Cancel</a>
		</div>
	</[[ name_pascal ]]Form>
</Layout>
