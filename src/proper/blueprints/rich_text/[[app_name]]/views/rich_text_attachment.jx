{#def attachment, alt: str = "", caption: str = "" #}

{#
Default renderer for an `attachment` node inside a Rich Text Document.

The framework hands us the resolved `Attachment` row plus the per-embed
`alt` and `caption` text from the AST.

Edit this file freely. The renderer only knows it should
route every `attachment` node through here, the visual layout is yours.
#}

{% if attachment.is_previewable %}
  {% set variant = attachment.variant(resize_to_limit=(1600, 1600)) %}
  <figure class="attachment attachment--preview attachment--{{ attachment.extension }}">
    <img src="{{ variant.url }}" alt="{{ alt or '' }}" loading="lazy">
    {% if caption -%}
    <figcaption class="attachment__caption">{{ caption }}</figcaption>
    {%- endif %}
  </figure>
{% else %}
  <a href="{{ attachment.url }}" target="_blank" rel="noopener">
    <figure
      class="attachment attachment--file attachment--{{ attachment.extension }}" data-content-type="{{ attachment.content_type }}">
      <span class="attachment__icon">{{ attachment.extension }}</span>
      <figcaption class="attachment__caption">
        <strong class="attachment__name">{{ attachment.filename }}</strong>
        <span class="attachment__size">{{ attachment.byte_size | format_size }}</span>
      </figcaption>
      </figure>
  </a>
{% endif %}