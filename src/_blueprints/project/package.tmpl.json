{
    "name": "[[ app_name ]]",
    "private": "true",
    "scripts": {
        "bundle": "concurrently npm:css npm:js",
        "watch": "concurrently -k npm:css:watch npm:js:watch",
        "build": "concurrently npm:css:build npm:js:build",
        "css": "postcss static_src/css/*.* --base static_src --dir static",
        "css:watch": "npm run css -- --watch",
        "css:build": "npm run css -- --env production",
        "js": "esbuild static_src/js/*.* --bundle --sourcemap --outdir=static/js/",
        "js:watch": "npm run js -- --watch",
        "js:build": "npm run js -- --minify"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.2",
        "concurrently": "^7.0.0",
        "esbuild": "^0.14.25",
        "postcss": "^8.4.8",
        "postcss-cli": "^9.1.0",
        "postcss-import": "^14.0.2",
        "tailwindcss": "^3.0.23"
    },
    "browserslist": "last 2 versions"
}
