{
    "name": "[[ app_name ]]",
    "private": "true",
    "scripts": {
        "bundle": "concurrently npm:css npm:js",
        "watch": "concurrently npm:css:watch npm:js:watch",
        "css": "tailwindcss -i ./static_src/css/app.css -o ./static/css/app.css",
        "css:watch": "npm run css -- --watch",
        "css:build": "npm run css -- --minify",
        "js": "esbuild static_src/js/*.* --bundle --sourcemap --outdir=static/js/",
        "js:watch": "npm run js -- --watch",
        "js:build": "npm run js -- --minify"
    },
    "devDependencies": {
        "concurrently": "^7.6.0",
        "esbuild": "^0.17.10",
        "tailwindcss": "^3.2.7"
    },
    "browserslist": "last 2 versions"
}
