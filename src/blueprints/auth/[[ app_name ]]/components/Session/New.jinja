{#def form #}

<Layout.Auth title="Sign in">
  <Form class="w-full p-12 bg-white border border-gray-300 shadow-xl rounded-xl">
    <div class="mb-8 text-center">
      <h2 class="mt-6 text-3xl font-bold text-gray-900">
        Sign in
      </h2>
    </div>

    {%- if form.login.error or form.password.error %}
    <div class="mt-2 mb-3 text-sm font-bold text-center text-red-500">
      {{ form.login.error or form.password.error }}
    </div>
    {% endif -%}

    <div class="mb-1">
      {{ form.login.as_input(
        aria_label="Email",
        classes="form-input w-full text-lg py-3 rounded-none rounded-t-md",
        error="",
        placeholder="Email",
        tabindex="1"
      ) }}
    </div>

    <div>
      {{ form.password.as_input(
        aria_label="Password",
        classes="form-input w-full text-lg py-3 rounded-none rounded-b-md",
        error="",
        placeholder="Password",
        tabindex="2"
      ) }}
    </div>

    <div class="mt-8">
      <button type="submit" class="w-full" tabindex="3">Sign in</button>
    </div>
  </Form>

  <div class="mt-10 text-center">
    <a class="link"
      href="{{ url_for('PasswordReset.new') }}"
      tabindex="4"
    >
      Forgot your password?
    </a>
  </div>
</Layout.Auth>
