{#def form #}
{% set f = form.fields %}

<Layout.Auth title="Sign in">
  <Form class="w-full p-12 bg-white border border-gray-300 shadow-xl rounded-xl">
    <div class="mb-8 text-center">
      <h2 class="mt-6 text-3xl font-bold text-gray-900">
        Sign in
      </h2>
    </div>

    {% if form.errors -%}
    <div class="mt-2 mb-3 text-sm font-bold text-center text-red-500">
      {% for error in form.errors -%}
        <p>{{ error.msg }}</p>
      {% endfor -%}
    </div>
    {%- endif %}

    <div class="mb-1">
      <input
        aria-label="Email"
        type="email"
        name="{{ f.login.name }}"
        value="{{ f.login.value }}"
        class="form-input w-full text-lg py-3 rounded-t-md"
        placeholder="Email"
        tabindex="1"
      />
      {% if f.login.error -%}
      <div class="text-red-500 text-sm font-bold p-2">
        {{ f.login.error.msg }}
      </div>
      {%- endif %}
    </div>

    <div>
      <input
        aria-label="Password"
        type="password"
        name="{{ f.password.name }}"
        value="{{ f.password.value }}"
        class="form-input w-full text-lg py-3 rounded-b-md"
        placeholder="Password"
        tabindex="1"
      />
      {% if f.password.error -%}
      <div class="text-red-500 text-sm font-bold p-2">
        {{ f.password.error.msg }}
      </div>
      {%- endif %}
    </div>

    <div class="mt-8">
      <button
        type="submit"
        class="btn btn-primary btn-md w-full"
        tabindex="3"
      >Sign in</button>
    </div>
  </Form>

  <div class="mt-10 text-center">
    <a class="link font-semibold"
      href="{{ url_for('PasswordReset.new') }}"
      tabindex="4"
    >
      Forgot your password?
    </a>
  </div>
</Layout.Auth>
