{#def form #}

<Layout.Auth title="Sign in">
  <Form class="w-full p-12 bg-white border border-gray-300 shadow-xl rounded-xl">
    <div class="mb-8 text-center">
      <h2 class="mt-6 text-3xl font-bold text-gray-900">
        Sign in
      </h2>
    </div>

    <FormErrors form={{ form }} />

    <div class="mb-1">
      <FormInput
        field={{ form.fields.login }}
        aria-label="Email"
        type="email"
        class="form-input w-full text-lg py-3 rounded-t-md"
        placeholder="Email"
        tabindex="1"
      />
    </div>

    <div>
      <FormInput
        field={{ form.fields.password }}
        aria-label="Password"
        type="password"
        class="form-input w-full text-lg py-3 rounded-b-md"
        placeholder="Password"
        tabindex="2"
      />
    </div>

    <div class="mt-8">
      <button
        type="submit"
        class="btn btn-primary btn-md w-full"
        tabindex="3"
      >Sign in</button>
    </div>
  </Form>

  <div class="mt-10 text-center">
    <a class="link font-semibold"
      href="{{ url_for('PasswordReset.new') }}"
      tabindex="4"
    >
      Forgot your password?
    </a>
  </div>
</Layout.Auth>
