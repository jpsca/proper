# Production environment for compose.yml — copy to .env and fill in.
# These are the exact variables the prod config reads ([[ app_name ]]/config/*.py).

# 48+ random chars, oldest-to-newest, comma-separated. Rotate by appending.
SECRET_KEYS=

# External Postgres
DB_HOST=
DB_PORT=5432
DB_NAME=[[app_name]]
DB_USER=
DB_PASSWORD=

# External Redis (Huey task queue)
REDIS_HOST=
REDIS_PORT=6379
REDIS_NAME=[[app_name]]

# SMTP (ses_smtp mailer)
SMTP_USERNAME=
SMTP_PASSWORD=

# Host port to publish the web server on (container always listens on 2300).
WEB_PORT=2300
