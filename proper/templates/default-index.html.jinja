  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <style type="text/css">
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      align-items: center;
      background-color: #eff8ff;
      background-image: linear-gradient(
        140deg,
        hsl(0deg 0% 100%) 0%,
        hsl(181deg 43% 93%) 38%,
        hsl(182deg 43% 86%) 51%,
        hsl(182deg 44% 78%) 60%,
        hsl(182deg 45% 71%) 66%,
        hsl(182deg 46% 63%) 71%,
        hsl(165deg 44% 65%) 75%,
        hsl(134deg 37% 70%) 79%,
        hsl(84deg 38% 68%) 83%,
        hsl(50deg 50% 67%) 88%,
        hsl(32deg 85% 74%) 100%
      );
      background-position: center center;
      background-repeat: no-repeat;
      background-size: cover;
      color: #261B23;
      display: flex;
      flex-direction: column;
      font-family: Sans-Serif;
      font-size: calc(0.9em + 0.5vw);
      font-style: normal;
      font-weight: 400;
      justify-content: center;
      line-height: 1.4;
      min-height: 100vh;
      text-align: center;
    }

    nav {
      width: 80%;
      text-align: center
    }

    nav svg {
      height: auto;
      width: 100%;
      max-height: 220px;
      max-width: 220px;
      fill: currentColor;
    }

    nav p {
      line-height: 1.5;
    }

    a {
      color: #1a4898;
      transition: all 0.25s cubic-bezier(0.33, 1, 0.68, 1);
      text-decoration: underline;
    }
    a:hover {
      text-decoration: none;
    }

    ul {
      bottom: 0;
      left: 0;
      list-style: none;
      margin: 0 2rem 2rem 2rem;
      position: absolute;
      right: 0;
    }
  </style>
</head>

