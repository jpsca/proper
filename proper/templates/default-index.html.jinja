<!DOCTYPE html>
<html lang="en">
<head>
  <title>Proper Web Framework {{ proper_version }}</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <style type="text/css">
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      align-items: center;
      background-color: #eff8ff;
      background-image: url(data:image/svg+xml;base64,PHN2ZyBoZWlnaHQ9IjEwMjQiIHZpZXdCb3g9IjAgMCAxNDQwIDEwMjQiIHdpZHRoPSIxNDQwIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjxwYXRoIGQ9Im0xNDQwIDUxMC4wMDA2NDh2LTUxMC4wMDA2NDhoLTE0NDB2Mzg0LjAwMDY0OGM0MTcuMzExOTM5IDEzMS4xNDIxNzkgODkxIDE3MS41MTMgMTQ0MCAxMjZ6IiBmaWxsPSIjZmZmIi8+PC9zdmc+);
      background-position: center center;
      background-repeat: no-repeat;
      background-size: cover;
      color: #261B23;
      display: flex;
      flex-direction: column;
      font-family: Sans-Serif;
      font-size: calc(0.9em + 0.5vw);
      font-style: normal;
      font-weight: 400;
      justify-content: center;
      line-height: 1.25;
      min-height: 100vh;
      text-align: center;
    }

    nav {
      font-size: 0;
      height: 20vw;
      line-height: 0;
      max-height: 280px;
      max-width: 280px;
      min-height: 140px;
      min-width: 140px;
      width: 20vw;
    }

    nav a {
      background: #215cc3;
      border-radius: 100%;
      display: flex;
      transition: background 0.25s cubic-bezier(0.33, 1, 0.68, 1);
    }

    nav a:hover {
      background: #232027;
    }

    nav a img {
      height: auto;
      max-width: 100%;
      width: 100%;
      cursor: pointer;
      color: white;
      padding: 20px;
    }

    ul {
      bottom: 0;
      left: 0;
      list-style: none;
      margin: 0 2rem 2rem 2rem;
      position: absolute;
      right: 0;
    }
  </style>
</head>

<body>
  <nav>
    <a href="https://getproper.org" target="_blank">
      <img alt="" src="data:image/svg+xml;base64," />
    </a>
  </nav>

  <ul>
    <li><strong>Proper version:</strong> {{ proper_version }}</li>
    <li><strong>Python version:</strong> {{ python_version }}</li>
  </ul>
</body>

</html>
