{% extends 'layout.html.jinja' %}

{% block styles %}
<style>
table.routes {
	border: 1px solid #ddd;
}
table.routes th {
	font-size: 11px;
	color: #999;
}
table.routes div {
	padding: 1px 4px;
	height: 20px;
	line-height: 20px;
}
table.routes th div {
	height: 10px;
	line-height: 10px;
}
</style>
{% endblock %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<h3>Routes</h3>
<p>Routes match in priority from top to bottom.</p>

<div class="scroll-container">
{%- for scope in routes %}
	<div class="table-header">Scope: {{ scope.mount }}
		{% if scope.rules %}, {{ scope.rules }}{% endif %}</div>
	<table class="routes">
		<tr>
			<th></th>
			<th><div>PATH</div></th>
			<th><div>TO</div></th>
			<th><div>NAME</div></th>
			<th><div>RULES</div></th>
			<th><div>DEFAULTS</div></th>
		</tr>
		{%- for route in scope.routes %}
		<tr>
			<td><div>{{ route.method if route.method else '—' }}<div></td>
			<td><div>{{ route.path }}<div></td>
			<td><div>{{ route.to or route.redirect or route.forward }}<div></td>
			<td><div>{{ route.name if route.name else '—' }}<div></td>
			<td><div>{{ route.rules if route.rules else '—' }}<div></td>
			<td><div>{{ route.defaults if route.defaults else '—' }}<div></td>
		</tr>
		{%- endfor %}
	</table>
{%- endfor %}
</div>
{% endblock %}
