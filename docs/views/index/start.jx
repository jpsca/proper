<section class="section start" id="start">
  <div class="section-inner start-inner">
    <h2 class="section-title">
      One command, and <em>a new project</em> appears
    </h2>
    <div class="install-cmd install-cmd-big highlight">
      <span class="prompt" aria-hidden="true">$ </span><code>uvx proper_new myapp</code>
