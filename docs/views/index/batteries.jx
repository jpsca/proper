<section class="section batteries" id="batteries">
  <div class="section-inner">
    <div class="section-head">
      <h2 class="section-title"><em>Batteries</em>, <br />all of them</h2>
      <p class="section-sub">
        The boring parts of every web app - solved, documented, and ready to
        import. No assembly. No glue code. No "pick your favorite from the
        ecosystem."
      </p>
    </div>
    <div class="battery-grid">
      <a href="/docs/models/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            viewBox="0 0 24 24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <ellipse cx="12" cy="6" rx="8" ry="3"></ellipse>
            <path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6"></path>
            <path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"></path>
          </svg>
          Peewee ORM
        </h3>
        <p class="battery-desc">
          A small, expressive ORM with migrations, query helpers, and
          async-safe connection handling.
        </p>
        <div class="battery-pkg">peewee</div>
      </a>

      <a href="/docs/forms/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            viewBox="0 0 24 24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <rect x="4" y="3" width="16" height="18" rx="2"></rect>
            <path d="M8 8h8M8 12h8M8 16h5"></path>
          </svg>
          Forms
        </h3>
        <p class="battery-desc">
          Declarative forms with field validation, ORM integration, and
          rendering helpers.
        </p>
        <div class="battery-pkg">proper.forms</div>
      </a>

      <a href="/docs/jx_components/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            viewBox="0 0 24 24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
          </svg>
          Jx components
        </h3>
        <p class="battery-desc">
          Server-rendered Python components - typed props, slots, and zero
          template language.
        </p>
        <div class="battery-pkg">jx</div>
      </a>

      <a href="/docs/caching/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            viewBox="0 0 24 24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              d="M4 7c0-1.1 3.6-2 8-2s8 .9 8 2v10c0 1.1-3.6 2-8 2s-8-.9-8-2z"
            ></path>
            <path d="M4 12c0 1.1 3.6 2 8 2s8-.9 8-2"></path>
          </svg>
          Caching
        </h3>
        <p class="battery-desc">
          Fragment, action, and low-level caching with SQLite or Redis
          backends.
        </p>
        <div class="battery-pkg">proper.cache</div>
      </a>

      <a href="/docs/tasks/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            viewBox="0 0 24 24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 3"></path>
          </svg>
          Background tasks
        </h3>
        <p class="battery-desc">
          Huey-powered queue with retries, schedules, and cron syntax.
        </p>
        <div class="battery-pkg">huey</div>
      </a>

      <a href="/docs/emails/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            viewBox="0 0 24 24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>
          Email
        </h3>
        <p class="battery-desc">
          Templated transactional mail with SMTP and console mailers for
          development.
        </p>
        <div class="battery-pkg">proper.emails</div>
      </a>

      <a href="/docs/authentication/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            viewBox="0 0 24 24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <rect x="5" y="11" width="14" height="9" rx="1.5"></rect>
            <path d="M8 11V7a4 4 0 018 0v4"></path>
          </svg>
          Authentication
        </h3>
        <p class="battery-desc">
          Sessions, password resets, rate limiting, and pwned-password checks
          out of the box.
        </p>
        <div class="battery-pkg">proper.auth</div>
      </a>

      <a href="/docs/storage/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            viewBox="0 0 24 24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M4 7l3-3h10l3 3v12a2 2 0 01-2 2H6a2 2 0 01-2-2z"></path>
            <path d="M9 4v4h6V4"></path>
          </svg>
          File storage
        </h3>
        <p class="battery-desc">
          Disk and S3 adapters with signed URLs and image variants.
        </p>
        <div class="battery-pkg">proper.storage</div>
      </a>

      <a href="/docs/rich_text/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            fill="none"
            viewBox="0 0 24 24"
            height="24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"
            />
          </svg>
          Rich Text Editor
        </h3>
        <p class="battery-desc">
          Rich content, including images, to replace boring text fields.
        </p>
        <div class="battery-pkg">proper.rich_text</div>
      </a>

      <a href="/docs/i18n/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            viewBox="0 0 24 24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18"></path>
          </svg>
          Internationalization
        </h3>
        <p class="battery-desc">
          Locale-aware routing, translations, pluralization, and date formats.
        </p>
        <div class="battery-pkg">proper.i18n</div>
      </a>

      <a href="/docs/channels/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            viewBox="0 0 24 24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              d="M5 9c2-3 5-4 7-4s5 1 7 4M5 15c2 3 5 4 7 4s5-1 7-4"
            ></path>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
          WebSockets
        </h3>
        <p class="battery-desc">
          Channels, broadcasts, and presence on top of the same ASGI runtime.
        </p>
        <div class="battery-pkg">proper.channels</div>
      </a>

      <a href="/docs/turbo/" class="battery">
        <h3 class="battery-name">
          <svg
            class="battery-icon"
            fill="none"
            viewBox="0 0 24 24"
            height="24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
          </svg>
          Turbo
        </h3>
        <p class="battery-desc">
          Speed up page changes and form submissions and stream partial page updates.
        </p>
        <div class="battery-pkg">proper.turbo</div>
